# Copy this file to .ops.env and fill secrets before running in your environment.

SIM_TRADING_STATE_DIR=demo/state
SIM_TRADING_REPORT_LOG=demo/reports-log.jsonl
SIM_TRADING_DASHBOARD_HOST=0.0.0.0
SIM_TRADING_DASHBOARD_PORT=8780
SIM_TRADING_WEBHOOK_HOST=0.0.0.0
SIM_TRADING_WEBHOOK_PORT=8765

# Dashboard auth
SIM_TRADING_DASHBOARD_BEARER_TOKEN=REPLACE_WITH_STRONG_TOKEN
SIM_TRADING_DASHBOARD_BASIC_USER=ops
SIM_TRADING_DASHBOARD_BASIC_PASS=REPLACE_WITH_STRONG_PASSWORD

# Webhook auth / replay protection
SIM_TRADING_WEBHOOK_TOKEN=REPLACE_WITH_STRONG_TOKEN
SIM_TRADING_WEBHOOK_REPLAY_TTL_SECONDS=300

# Notification hook (optional)
SIM_TRADING_NOTIFY_CHANNEL=telegram
SIM_TRADING_NOTIFY_TELEGRAM_TARGET=REPLACE_WITH_TARGET
SIM_TRADING_NOTIFY_HOOK='/absolute/path/to/push_report_telegram.sh'

# Scheduler switches
RUN_EXECUTE_SIM=1
EXECUTE_SIM_NOTIFY=0
RUN_VALIDATE_STRATEGY=0
RUN_DS_SHADOW=1
DS_SHADOW_EVERY_HOURS=1
DISABLE_LEGACY_HOURLY=1

# Tick cadence
UNIVERSE_REFRESH_EVERY_MINUTES=5
BASELINE_STRATEGY_EVERY_MINUTES=1
DS_CONSERVATIVE_STRATEGY_EVERY_MINUTES=1
DS_AGGRESSIVE_STRATEGY_EVERY_MINUTES=1

# DeepSeek
SIM_TRADING_DEEPSEEK_ENABLED=1
SIM_TRADING_DEEPSEEK_BASE_URL=https://api.deepseek.com
SIM_TRADING_DEEPSEEK_MODEL=deepseek-chat
SIM_TRADING_DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
SIM_TRADING_DEEPSEEK_TIMEOUT_SECONDS=45
SIM_TRADING_DEEPSEEK_MAX_RETRIES=3
